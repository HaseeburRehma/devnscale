# Resend API key for the /api/contact endpoint.
# Grab from https://resend.com/api-keys — needs `emails.send` scope.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where owner notifications are delivered. Defaults to
# waseeq.aftab@devnscale.com if unset.
CONTACT_INBOX=waseeq.aftab@devnscale.com

# From-address for both the owner notification and the visitor
# confirmation. MUST be on a domain verified in your Resend workspace
# (add + verify devnscale.com in https://resend.com/domains).
# Format: "Display Name <address@your-verified-domain.com>"
# Leave unset in local dev to fall back to Resend's shared sender.
CONTACT_FROM=Dev N Scale <hello@devnscale.com>
